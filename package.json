{
  "name": "litshelf",
  "productName": "文献架 LitShelf",
  "version": "1.0.2",
  "private": true,
  "license": "MIT",
  "author": "blueric4",
  "type": "module",
  "description": "文献架 LitShelf —— 本地文献阅读与管理软件：扫描你的文献文件夹，在软件内直接阅读 PDF，文件夹变了软件内自动跟着变。",
  "main": "dist/main/index.mjs",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "node scripts/dev-web.mjs",
    "build": "node scripts/build.mjs",
    "start:web": "node scripts/build.mjs --server && node dist/server/index.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "dist": "node scripts/build.mjs && electron-builder --win nsis"
  },
  "dependencies": {
    "chokidar": "^4.0.3",
    "dompurify": "^3.4.16",
    "highlight.js": "^11.12.0",
    "katex": "^0.16.25",
    "mammoth": "^1.13.0",
    "marked": "^18.1.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^5.7.284"
  },
  "devDependencies": {
    "@tanstack/react-virtual": "^3.14.13",
    "@types/node": "^24.19.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.3",
    "zustand": "^5.0.15"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild"
    ]
  },
  "build": {
    "appId": "com.litshelf.app",
    "productName": "文献架 LitShelf",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json",
      "node_modules/**/*"
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "文献架 LitShelf"
    }
  }
}
